{
  "name": "dsh-desktop-host",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Desktop host bridge plugin for DSH Desktop: reports readiness and theme changes to the Electron shell.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./webserver": "./webserver.js",
    "./browser-url-route": "./browser-url-route.js",
    "./lan-url-route": "./lan-url-route.js",
    "./lan-http-ingress": "./lan-http-ingress.js",
    "./upstream-session-broker": "./upstream-session-broker.js",
    "./control": "./control.js",
    "./access-state": "./access-state.js",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-host-webserver": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["theme", "sessions", "commandUi", "locale"]
    }
  }
}
